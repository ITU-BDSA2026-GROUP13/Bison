@page
@model Bison.Razor.Pages.StatisticsModel
@{
    ViewData["Title"] = "Stats";
}

<h1>Spotted birds</h1>

<table class="table">
    <thead>
        <tr><th>Taxon</th><th>Sightings</th></tr>
    </thead>
    <tbody>
    @foreach (var c in Model.Counts)
    {
        <tr>
            <td>@c.TaxonId</td>
            <td>@c.Count</td>
        </tr>
    }
    </tbody>
</table>