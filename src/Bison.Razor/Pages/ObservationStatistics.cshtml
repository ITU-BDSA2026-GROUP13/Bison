@page "/stats"
@model Bison.Razor.Pages.StatsModel
@{
    ViewData["Title"] = "Stats";
}

<h1>Spotted birds</h1>

<table class="table">
    <thead>
        <tr><th>Taxon</th><th>Sightings</th></tr>
    </thead>
    <tbody>
    @foreach (var stat in Model.Stats)
    {
        <tr>
            <td>@stat.VernacularName</td>
            <td>@stat.Count</td>
        </tr>
    }
    </tbody>
</table>