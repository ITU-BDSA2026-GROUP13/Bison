@page "/ob/{id:long?}"
@model Bison.Razor.Pages.ObservationDetailModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    <h2>Observation</h2>

    @if (Model.Observation != null)
    { 
        <p>
            <strong><a href="/obs/@Model.Observation.AuthorId">@Model.Observation.AuthorName</a></strong>
            @Model.Observation.Text
            <small>&mdash; @Model.Observation.TimeStamp</small>
        </p>
    }
</div>

<div>
    <h3>Proposals</h3>
    @* if there are proposals: a <ul> with a foreach; else an <em> message *@
    @if (Model.Proposals.Any())
    {
        <ul id="proposalList" class="proposal">
            @foreach (var p in Model.Proposals)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@p.AuthorId">@p.AuthorName</a>
                        </strong>
                        @p.TaxonName
                        <small>&mdash; @p.TimeStamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no proposals so far.</em>
    }
</div>

<div>
    <h3>Comments</h3>
    @if (Model.Comments.Any())
    {
        <ul id="commentList" class="comments">
            @foreach (var cm in Model.Comments)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@cm.AuthorId">@cm.AuthorName</a>
                        </strong>
                        @cm.Text
                        <small>&mdash; @cm.TimeStamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no comments so far.</em>
    }
</div>