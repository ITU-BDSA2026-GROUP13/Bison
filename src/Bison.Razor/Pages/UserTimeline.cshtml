@page "/obs/{authorId}"
@using Bison
@using System.Security.Claims
@model Bison.Razor.Pages.UserTimelineModel
@inject SignInManager<Author> SignInManager
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("author");
}

<div>
    
    @if (Model.FilteredTaxon != null)
    {
        <p>
            Showing observations of <strong>@Model.FilteredTaxon</strong>
            <a href="?">(clear filter)</a>
        </p>
    }
    
    @if (Model.MyPage)
    {
        <h2> My Observations </h2>
        <partial name="Shared/_AddObservationPartial" for="NewObservation"/>
    } else if (Model.Observations.Any())
    {
        <h2> @Model.Observations.First().AuthorName Observations </h2>
    }
    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var ob in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="@ob.AuthorId">@ob.AuthorName</a>
                        </strong>
                        <a href="/ob/@ob.ObservationId" style="color: inherit; text-decoration: none;">@ob.Text</a> <small>&mdash; @ob.TimeStamp</small>
                        <br>
                        <small>
                            <a href="?taxonId=@ob.dwc_TaxonId"> - @ob.TaxonName</a>
                        </small>
                    </p>
                    @if (!string.IsNullOrEmpty(ob.ImageFileString))
                    {
                        <div class="observation-image-frame">
                            <img src="/images/@ob.ImageFileString"
                                 alt="Picture of the observed animal" />
                        </div>
                    }
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no Observations so far.</em>
    }
</div>
<div class="pagination">
    @if (Model.CurrentPage > 1)
    {
        <a href="?taxonId=@Model.FilteredTaxon&page=@(Model.CurrentPage - 1)">Previous</a>
    }
    <span>Page @Model.CurrentPage</span>
    @if (Model.Observations.Count == 32)
    {
        <a href="?taxonId=@Model.FilteredTaxon&page=@(Model.CurrentPage + 1)">Next</a>
    }
</div>
