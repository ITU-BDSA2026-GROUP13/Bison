@page "/obs"
@model Bison.Razor.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    <h2> Public Timeline </h2>
    @if (Model.FilteredTaxon != null)
    {
        <p>
            Showing observations of <strong>@Model.FilteredTaxon</strong>
            <a href="?">(clear filter)</a>
        </p>
    }
    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="obs/@obs.AuthorId">@obs.AuthorName</a>
                        </strong>
                        @obs.Text
                        <small>&mdash; @obs.TimeStamp</small>
                        <br>
                        <small>
                             <a href="?taxonId=@obs.dwc_TaxonId"> - @obs.TaxonName</a>
                        </small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }
</div>
    <div class="pagination">
        @if (Model.CurrentPage > 1)
        {
            <a href="?taxonId=@Model.FilteredTaxon&page=@(Model.CurrentPage - 1)">Previous</a>
        }
        <span>Page @Model.CurrentPage</span>
        @if (Model.Observations.Count == 32)
        {
            <a href="?taxonId=@Model.FilteredTaxon&page=@(Model.CurrentPage + 1)">Next</a>
        }
    </div>
