@page "/aboutme/{authorId}"
@model Bison.Razor.Pages.AboutMe

@{
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("authorId");

}

<!DOCTYPE html>

<html>
<head>
    <title></title>
</head>
<body>
<div>
    <h1>About me</h1>
    
    <h2>Personal data </h2>
    <ul>
        @foreach (var property in Model.UserData!.GetType().GetProperties())
        {
            <li><b>@property.Name:</b> @property.GetValue(Model.UserData)</li>
        }
    </ul>
    
    <br/>
    <br/>
    <h2>Personal observations</h2>
    @if (Model.ObservationData.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var ob in Model.ObservationData)
            {
                <li>
                    <p>
                        <strong>
                            <a href="@ob.AuthorId">@ob.AuthorName</a>
                        </strong>
                        <a href="/ob/@ob.ObservationId" style="color: inherit; text-decoration: none;">@ob.Text</a>
                        <small>&mdash; @ob.TimeStamp</small>
                        <br>
                        <small>
                            <a href="?taxonId=@ob.dwc_TaxonId"> - @ob.TaxonName</a>
                        </small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no Observations so far.</em>
    }
    
</div>
</body>
</html>