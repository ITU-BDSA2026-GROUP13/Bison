@page "/aboutme/{authorId}"
@model Bison.Razor.Pages.AboutMe

@{
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("authorId");

}

<!DOCTYPE html>

<html>
<head>
    <title></title>
</head>
<body>
<div>
    <h1>About me</h1>
    
    <h2>Personal data </h2>
    <ul>
        @foreach (var property in Model.UserData!.GetType().GetProperties())
        {
            <li><b>@property.Name:</b> @property.GetValue(Model.UserData)</li>
        }
    </ul>
    
    <br/>
    <br/>
    <h2>Personal observations</h2>
    @if (Model.ObservationData.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var ob in Model.ObservationData)
            {
                <li>
                    <p>
                        <strong>
                            <a href="@ob.AuthorId">@ob.AuthorName</a>
                        </strong>
                        <a href="/ob/@ob.ObservationId" style="color: inherit; text-decoration: none;">@ob.Text</a>
                        <small>&mdash; @ob.TimeStamp</small>
                        <br>
                        <small>
                            <a href="?taxonId=@ob.dwc_TaxonId"> - @ob.TaxonName</a>
                        </small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>You have not made any observations</em>
    }

    <h2>Personal comments</h2>
    @if (Model.CommentData.Any())
    {
        <ul id="commentList" class="comments">
            @foreach (var cm in Model.CommentData)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@cm.AuthorId">@cm.AuthorName</a>
                        </strong>
                        @cm.Text
                        <small>&mdash; @cm.TimeStamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>You have not made any comments</em>
    }

    <h3>Proposals</h3>
    @* if there are proposals: a <ul> with a foreach; else an <em> message *@
    @if (Model.ProposalData.Any())
    {
        <ul id="proposalList" class="proposal">
            @foreach (var p in Model.ProposalData)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@p.AuthorId">@p.AuthorName</a>
                        </strong>
                        @p.TaxonName
                        <small>&mdash; @p.TimeStamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>You have not made any proposals</em>
    }
</div>
</body>
</html>