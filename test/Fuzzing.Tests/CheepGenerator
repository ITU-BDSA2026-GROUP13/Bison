namespace Bison.FuzzTests;

public class CheepGenerator
{
    // Komma, citationstegn og æøå, fordi databasen er en CSV-fil. Ingen linjeskift endnu.
    private const string Alphabet = "abcXYZ019 ,\";'æøåÆØÅ-_";

    private readonly Random rng;

    public CheepGenerator(Random rng)
    {
        this.rng = rng;
    }

    public Cheep Generate() => new Cheep(RandomText(rng), RandomText(rng));

    // Deles med CommentGenerator.
    public static string RandomText(Random rng)
    {
        var len = rng.Next(1, 40);
        return new string(Enumerable.Range(0, len)
            .Select(_ => Alphabet[rng.Next(Alphabet.Length)]).ToArray());
    }
}